programa
{
	
	funcao inicio()
	{
	  cadeia nome_usuario
		escreva("Qual o seu nome: ")
            leia (nome_usuario)
          cadeia idade
	         escreva("Qual sua idade:")
              leia (idade)
              
	   escreva( "Olá, " ,nome_usuario, " Sua idade é ", idade)
	}
}
